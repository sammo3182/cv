@unpublished{HuYue2025i,
  type = {Invited talk},
  title = {How and When Economic Inequality Changes Minds},
  author = {{胡悦}},
  date = {2025-11-03},
  series = {比较政治学讲座系列},
  urldate = {2026-01-05},
  abstract = {How and When Economic Inequality Changes Minds As economic inequality keeps growing, citizens don't seem to demand more redistribution. Why not? Existing explanations suggest that people either do not know/care about inequality; or, they might stay hopeful because of economic growth. But what if people do know about inequality, and the economy turns bad? I thus offer a third answer: economic inequality changes how people think. Using evidence from the United States and China, I illustrate that living with inequality reshapes how individuals perceive their own economic position and their preferences toward redistribution. These effects reveal the micro-level reasons why countries can remain stable amid rising inequality and highlight the (missing) micro-foundations for redistribution reforms in highly unequal societies. Yue Hu is an Associate Professor in the Department of Political Science at Tsinghua University. His current research focuses on political psychology and behavior, political linguistics, and political communication. He has authored and co-authored articles in journals such as the~American Political Science Review,~Journal of Politics,~British Journal of Political Science, and~Political Psychology, among others. For more, see:~https://www.drhuyue.site},
  langid = {english},
  venue = {美国奥斯汀大学}
}

